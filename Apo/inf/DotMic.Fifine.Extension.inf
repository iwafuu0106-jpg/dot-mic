[Version]
Signature="$WINDOWS NT$"
Class=Extension
ClassGuid={e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider=%Provider%
ExtensionId={e8d7b791-48a6-4f41-81c5-3936e0643be7}
DriverVer=10/07/2026,0.3.4.0
CatalogFile=DotMic.Fifine.Extension.cat
PnpLockDown=1
[Manufacturer]
%Provider%=Targets,NTamd64.10.0...22621
[Targets.NTamd64.10.0...22621]
%ExtensionDesc%=Install,USB\VID_3142&PID_00C1&MI_00
[Install]
[Install.Components]
AddComponent=DotMicGate,,Apo_Component
AddComponent=MsApoFxProxy,,Proxy_Component
[Apo_Component]
ComponentIDs=VEN_DOTM&CID_GATE_8F611FC3
Description="DOT MIC Capture MFX component"
[Proxy_Component]
ComponentIDs=VEN_MSFT&CID_PROXYAPO
Description="Microsoft APO Proxy"
[Install.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,GLOBAL,CaptureFx
AddInterface=%KSCATEGORY_CAPTURE%,GLOBAL,CaptureFx
[CaptureFx]
AddReg=MFX,CAPX
[MFX]
HKR,FX\0,%PKEY_FX_Association%,,%KSNODETYPE_MICROPHONE%
HKR,FX\0,%PKEY_FX_ModeEffectClsid%,,%Clsid%
; DEFAULT is the observed Discord Standard mode. No new SFX/EFX/RAW registration.
HKR,FX\0,%PKEY_MFX_Modes%,0x00010000,%ModeDefault%
[CAPX]
HKR,FX\0\%Context%,%PKEY_FX_Association%,,%KSNODETYPE_MICROPHONE%
; CAPX Open*PropertyStore opens existing stores only. KEYONLY never replaces values.
HKR,FX\0\%Context%\User,,0x00000010
HKR,FX\0\%Context%\Volatile,,0x00000010
; Defaults only: OS-managed User values are never overwritten by installation.
HKR,FX\0\%Context%\Default,"{91795F52-2DC0-4E20-A732-58816672E635},1",0x00010001,0
HKR,FX\0\%Context%\Default,"{91795F52-2DC0-4E20-A732-58816672E635},2",,"0"
HKR,FX\0\%Context%\Default,"{91795F52-2DC0-4E20-A732-58816672E635},3",0x00010001,0
HKR,FX\0\%Context%\Default,"{91795F52-2DC0-4E20-A732-58816672E635},4",,"-48"
HKR,FX\0\%Context%\Default,"{91795F52-2DC0-4E20-A732-58816672E635},5",,"5"
HKR,FX\0\%Context%\Default,"{91795F52-2DC0-4E20-A732-58816672E635},6",,"160"
HKR,FX\0\%Context%\Default,"{91795F52-2DC0-4E20-A732-58816672E635},7",,"120"
HKR,FX\0\%Context%\Default,"{91795F52-2DC0-4E20-A732-58816672E635},8",0x00010001,0
HKR,FX\0\%Context%\Default,"{91795F52-2DC0-4E20-A732-58816672E635},9",,"6"
