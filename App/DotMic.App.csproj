<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DotMic.ico</ApplicationIcon>
    <AssemblyName>DotMic.App</AssemblyName>
    <RootNamespace>DotMic</RootNamespace>
    <Version>0.5.0-rc.1</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Shared/NativeTextBuffer.cs" Link="NativeTextBuffer.cs" />
    <Compile Include="../Shared/CaptureEligibility.cs" Link="CaptureEligibility.cs" />
    <Compile Include="../Shared/ApplicationExitPolicy.cs" Link="ApplicationExitPolicy.cs" />
    <Compile Include="../Shared/InputObservation.cs" Link="InputObservation.cs" />
    <Content Include="Assets\DotMic.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250606001" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.3916" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.20250528.2" />
  </ItemGroup>
  <!-- Unpackaged SDK publish omits generated XAML resources unless explicitly listed. -->
  <Target Name="PublishXamlResources" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <_DotMicXamlFiles Include="$(OutDir)**\*.xbf" />
      <ResolvedFileToPublish Include="$(OutDir)$(AssemblyName).pri" RelativePath="$(AssemblyName).pri" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="@(_DotMicXamlFiles)" RelativePath="%(_DotMicXamlFiles.RecursiveDir)%(_DotMicXamlFiles.Filename)%(_DotMicXamlFiles.Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
