; Feasibility gate only. Exact fifine audio-interface HWID; no broad USB class match.
; Existing GLOBAL interface and microphone connector category were read on the target.
[Version]
Signature="$WINDOWS NT$"
Class=Extension
ClassGuid={e2f84ce7-8efa-411c-aa69-97454ca4cb57}
Provider=%Provider%
ExtensionId={e8d7b791-48a6-4f41-81c5-3936e0643be7}
DriverVer=10/07/2026,0.1.1.0
CatalogFile=DotMic.Fifine.Extension.cat
PnpLockDown=1

[Manufacturer]
%Provider%=Targets,NTamd64.10.0...22621

[Targets.NTamd64.10.0...22621]
%ExtensionDesc%=Target_Install,USB\VID_3142&PID_00C1&MI_00

[Target_Install]

[Target_Install.Components]
AddComponent=DotMicGate,,Gate_Component
AddComponent=MsApoFxProxy,,Proxy_Component

[Gate_Component]
ComponentIDs=VEN_DOTM&CID_GATE_8F611FC3
Description=%ComponentDesc%

[Proxy_Component]
ComponentIDs=VEN_MSFT&CID_PROXYAPO
Description="Microsoft APO Proxy"

[Target_Install.Interfaces]
; Reuse the exact pre-existing GLOBAL reference for this USB audio interface.
; AddInterface here attaches properties, not a new KS filter/virtual capture device.
; AUDIO GLOBAL is the actual connected interface; subtype excludes render connectors.
AddInterface=%KSCATEGORY_AUDIO%,GLOBAL,Target_CaptureFx
AddInterface=%KSCATEGORY_CAPTURE%,GLOBAL,Target_CaptureFx

[Target_CaptureFx]
AddReg=Capture_MFX

[Capture_MFX]
HKR,FX\0,%PKEY_FX_Association%,,%KSNODETYPE_MICROPHONE%
HKR,FX\0,%PKEY_FX_ModeEffectClsid%,,%GateClsid%
; Two candidate modes for ONE no-op observation. RAW is intentionally not registered.
; Narrow to the observed real stream mode(s) only if the gate succeeds.
HKR,FX\0,%PKEY_MFX_Modes%,0x00010000,%ModeDefault%,%ModeCommunications%
; No SFX, EFX, capture device creation, FriendlyName or processing-mode override.

[Strings]
Provider="DOT MIC"
ExtensionDesc="DOT MIC fifine no-op capture gate extension"
ComponentDesc="DOT MIC no-op capture MFX gate component"
GateClsid="{8F611FC3-1A33-477D-9820-F8B9A11D1030}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSNODETYPE_MICROPHONE="{DFF21BE1-F70F-11D0-B917-00A0C9223196}"
PKEY_FX_Association="{D04E05A6-594B-4FB6-A80D-01AF5EED7D1D},0"
PKEY_FX_ModeEffectClsid="{D04E05A6-594B-4FB6-A80D-01AF5EED7D1D},6"
PKEY_MFX_Modes="{D3993A3F-99C2-4402-B5EC-A92A0367664B},6"
ModeDefault="{C18E2F7E-933D-4965-B7D1-1EEF228D2AF3}"
ModeCommunications="{98951333-B9CD-48B1-A0A3-FF40682D73F7}"
