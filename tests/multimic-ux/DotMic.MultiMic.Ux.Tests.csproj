<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <PropertyGroup Condition="'$(CompileSetupForm)' == 'true'">
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../Community/Setup/MultiSetupActions.cs" Link="MultiSetupActions.cs" />
    <Compile Include="../../Community/Setup/MultiSetupPresentation.cs" Link="MultiSetupPresentation.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(CompileSetupForm)' == 'true'">
    <Compile Include="../../Community/Setup/SetupForm.cs" Link="SetupForm.cs" />
    <Compile Include="../../Community/Setup/SetupWorker.cs" Link="SetupWorker.cs" />
    <Compile Include="../../Community/Setup/RecoveryDecision.cs" Link="RecoveryDecision.cs" />
    <Compile Include="FormCompileStubs.cs" />
  </ItemGroup>
</Project>
